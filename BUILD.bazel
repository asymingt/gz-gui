genrule(
    name = "cmdgui_ruby_script",
    srcs = ["src/cmd/cmdgui.rb.in"],
    outs = ["src/cmd/cmdgui.rb"],
    cmd = "sed -e 's|@library_location@|../../libgz-gui-shared.so|g' " +
          "-e 's|@PROJECT_VERSION_FULL@|10.0.0|g' $< > $@",
    visibility = ["//visibility:public"],
)

genrule(
    name = "gui_yaml",
    srcs = ["conf/gui.yaml.in"],
    outs = ["conf/gui.yaml"],
    cmd = "sed -e 's|@PROJECT_NAME_NO_VERSION@|gz-gui|g' " +
          "-e 's|@PROJECT_VERSION_FULL@|10.0.0|g' " +
          "-e 's|@gz_library_path@|cmdgui|g' $< > $@",
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "libgz-gui-shared.so",
    linkshared = True,
    linkstatic = False,
    deps = [
        ":gz-gui",
    ],
    visibility = ["//visibility:public"],
)




