load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_gazebo//gazebo:headers.bzl", "gz_configure_header", "gz_export_header")
load("@rules_license//rules:license.bzl", "license")
load(":gui_plugins.bzl", "gz_gui_plugin")

package(
    default_applicable_licenses = [":license"],
)

license(
    name = "license",
    package_name = "gz-gui",
)

licenses(["notice"])

exports_files([
    "package.xml",
    "LICENSE",
])

gz_export_header(
    name = "Export",
    out = "include/gz/gui/Export.hh",
    export_base = "GZ_GUI",
    lib_name = "gz-gui",
)

gz_configure_header(
    name = "config",
    src = "include/gz/gui/config.hh.in",
    package_xml = "package.xml",
)

moc_headers = [
    ("moc_Application", "include/gz/gui/Application.hh"),
    ("moc_Dialog", "include/gz/gui/Dialog.hh"),
    ("moc_MainWindow", "include/gz/gui/MainWindow.hh"),
    ("moc_PlottingInterface", "include/gz/gui/PlottingInterface.hh"),
    ("moc_Plugin", "include/gz/gui/Plugin.hh"),
]

[
    genrule(
        name = name,
        srcs = [hdr],
        outs = ["moc_" + hdr.split("/")[-1].replace(".hh", "").replace(".h", "") + ".cpp"],
        cmd = select({
            "@rules_qt//:linux_x86_64": "$(location @qt_linux_x86_64//:moc) $< -o $@",
            "@rules_qt//:linux_aarch64": "$(location @qt_linux_aarch64//:moc) $< -o $@",
            "@rules_qt//:osx_arm64": "$(location @qt_mac_aarch64//:moc) $< -o $@",
            "@rules_qt//:osx_x86_64": "$(location @qt_mac_x86_64//:moc) $< -o $@",
            "@platforms//os:windows": "$(location @qt_windows_x86_64//:moc) $< -o $@",
            "@platforms//os:linux": "$(location @qt_linux_x86_64//:moc) $< -o $@",
            "//conditions:default": "$(location @qt_linux_x86_64//:moc) $< -o $@",
        }),
        tools = select({
            "@rules_qt//:linux_x86_64": ["@qt_linux_x86_64//:moc"],
            "@rules_qt//:linux_aarch64": ["@qt_linux_aarch64//:moc"],
            "@rules_qt//:osx_arm64": ["@qt_mac_aarch64//:moc"],
            "@rules_qt//:osx_x86_64": ["@qt_mac_x86_64//:moc"],
            "@platforms//os:windows": ["@qt_windows_x86_64//:moc"],
            "//conditions:default": ["@qt_linux_x86_64//:moc"],
        }),
    )
    for name, hdr in moc_headers
]

moc_files = [":" + name for name, _ in moc_headers]

genrule(
    name = "resources_rcc",
    srcs = [
        "include/gz/gui/resources.qrc",
        "include/gz/gui/qtquickcontrols2.conf",
        "include/gz/gui/qml/qmldir",
    ] + glob([
        "include/gz/gui/qml/**/*.qml",
        "include/gz/gui/qml/images/*",
    ]),
    outs = ["resources_rcc.cpp"],
    cmd = select({
        "@rules_qt//:linux_x86_64": "ROOT=$$PWD && cd $$(dirname $(location include/gz/gui/resources.qrc)) && $$ROOT/$(location @qt_linux_x86_64//:rcc) --name gz_gui --output $$ROOT/$@ resources.qrc",
        "@rules_qt//:linux_aarch64": "ROOT=$$PWD && cd $$(dirname $(location include/gz/gui/resources.qrc)) && $$ROOT/$(location @qt_linux_aarch64//:rcc) --name gz_gui --output $$ROOT/$@ resources.qrc",
        "@rules_qt//:osx_arm64": "ROOT=$$PWD && cd $$(dirname $(location include/gz/gui/resources.qrc)) && $$ROOT/$(location @qt_mac_aarch64//:rcc) --name gz_gui --output $$ROOT/$@ resources.qrc",
        "@rules_qt//:osx_x86_64": "ROOT=$$PWD && cd $$(dirname $(location include/gz/gui/resources.qrc)) && $$ROOT/$(location @qt_mac_x86_64//:rcc) --name gz_gui --output $$ROOT/$@ resources.qrc",
        "@platforms//os:windows": "ROOT=$$PWD && cd $$(dirname $(location include/gz/gui/resources.qrc)) && $$ROOT/$(location @qt_windows_x86_64//:rcc) --name gz_gui --output $$ROOT/$@ resources.qrc",
        "//conditions:default": "ROOT=$$PWD && cd $$(dirname $(location include/gz/gui/resources.qrc)) && $$ROOT/$(location @qt_linux_x86_64//:rcc) --name gz_gui --output $$ROOT/$@ resources.qrc",
    }),
    tools = select({
        "@rules_qt//:linux_x86_64": ["@qt_linux_x86_64//:rcc"],
        "@rules_qt//:linux_aarch64": ["@qt_linux_aarch64//:rcc"],
        "@rules_qt//:osx_arm64": ["@qt_mac_aarch64//:rcc"],
        "@rules_qt//:osx_x86_64": ["@qt_mac_x86_64//:rcc"],
        "@platforms//os:windows": ["@qt_windows_x86_64//:rcc"],
        "//conditions:default": ["@qt_linux_x86_64//:rcc"],
    }),
)

genrule(
    name = "bazel_installation_directories",
    outs = ["src/bazel/InstallationDirectories.cc"],
    cmd = """cat << 'EOF' > $@
#include <gz/gui/InstallationDirectories.hh>
namespace gz {
namespace gui {
inline namespace GZ_GUI_VERSION_NAMESPACE {
std::string getInstallPrefix() {
  return ".";
}
}
}
}
EOF
""",
)

sources = [
    "src/Application.cc",
    "src/Conversions.cc",
    "src/Dialog.cc",
    "src/DragDropModel.cc",
    "src/GuiEvents.cc",
    "src/Helpers.cc",
    "src/gz.cc",
    "src/InstallationDirectories.cc",
    "src/MainWindow.cc",
    "src/PlottingInterface.cc",
    "src/Plugin.cc",
    "src/SearchModel.cc",
    ":bazel_installation_directories",
]

public_headers = glob([
    "include/gz/gui/**/*.hh",
    "include/gz/gui/**/*.h",
]) + [
    "include/gz/gui/config.hh",
    "include/gz/gui/Export.hh",
]

cc_library(
    name = "gz-gui-headers",
    hdrs = public_headers,
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@gz-common",
        "@gz-math",
        "@gz-msgs",
        "@gz-plugin//:loader",
        "@gz-transport",
        "@rules_qt//:qt_core",
        "@rules_qt//:qt_gui",
        "@rules_qt//:qt_hdrs",
        "@rules_qt//:qt_qml",
        "@rules_qt//:qt_quick",
        "@rules_qt//:qt_quick_controls2",
        "@rules_qt//:qt_widgets",
        "@tinyxml2",
    ],
)

cc_library(
    name = "gz-gui",
    srcs = sources + moc_files + [":resources_rcc"],
    hdrs = public_headers,
    copts = [
        "-fPIC",
    ],
    defines = select({
        "@platforms//os:windows": [
            'SHARED_LIBRARY_PREFIX=\\"\\"',
            'SHARED_LIBRARY_SUFFIX=\\".dll\\"',
        ],
        "@platforms//os:macos": [
            'SHARED_LIBRARY_PREFIX=\\"lib\\"',
            'SHARED_LIBRARY_SUFFIX=\\".dylib\\"',
        ],
        "//conditions:default": [
            'SHARED_LIBRARY_PREFIX=\\"lib\\"',
            'SHARED_LIBRARY_SUFFIX=\\".so\\"',
        ],
    }),
    includes = ["include"],
    local_defines = [
        'GZ_GUI_PLUGIN_RELATIVE_INSTALL_DIR=\\"\\"',
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@gz-common",
        "@gz-common//events",
        "@gz-math",
        "@gz-msgs",
        "@gz-plugin//:loader",
        "@gz-transport",
        "@libx11",
        "@libxrandr",
        "@opengl-registry//:OpenGL_headers",
        "@rules_qt//:qt_core",
        "@rules_qt//:qt_gui",
        "@rules_qt//:qt_hdrs",
        "@rules_qt//:qt_opengl",
        "@rules_qt//:qt_opengl_widgets",
        "@rules_qt//:qt_qml",
        "@rules_qt//:qt_qml_meta",
        "@rules_qt//:qt_qml_workerscript",
        "@rules_qt//:qt_quick",
        "@rules_qt//:qt_quick_controls2",
        "@rules_qt//:qt_quick_controls2_impl",
        "@rules_qt//:qt_quick_templates2",
        "@rules_qt//:qt_widgets",
        "@tinyxml2",
    ],
)

gz_gui_plugin(
    name = "MinimalScene",
    srcs = [
        "src/plugins/minimal_scene/EngineToQtInterface.cc",
        "src/plugins/minimal_scene/MinimalScene.cc",
        "src/plugins/minimal_scene/MinimalSceneRhi.cc",
        "src/plugins/minimal_scene/MinimalSceneRhiOpenGL.cc",
        "src/plugins/minimal_scene/MinimalSceneRhiVulkan.cc",
    ],
    hdrs = [
        "src/plugins/minimal_scene/EngineToQtInterface.hh",
        "src/plugins/minimal_scene/MinimalSceneRhi.hh",
        "src/plugins/minimal_scene/MinimalSceneRhiMetal.hh",
        "src/plugins/minimal_scene/MinimalSceneRhiOpenGL.hh",
        "src/plugins/minimal_scene/MinimalSceneRhiVulkan.hh",
    ],
    moc_headers = [
        "src/plugins/minimal_scene/MinimalScene.hh",
    ],
    qml = ["src/plugins/minimal_scene/MinimalScene.qml"],
    qrc = "src/plugins/minimal_scene/MinimalScene.qrc",
    deps = [
        "@gz-rendering",
        "@gz-transport",
        "@opengl-registry//:OpenGL_headers",
    ],
)

gz_gui_plugin(
    name = "InteractiveViewControl",
    srcs = [
        "src/plugins/interactive_view_control/InteractiveViewControl.cc",
    ],
    moc_headers = [
        "src/plugins/interactive_view_control/InteractiveViewControl.hh",
    ],
    qml = ["src/plugins/interactive_view_control/InteractiveViewControl.qml"],
    qrc = "src/plugins/interactive_view_control/InteractiveViewControl.qrc",
    deps = [
        "@gz-rendering",
    ],
)

gz_gui_plugin(
    name = "MarkerManager",
