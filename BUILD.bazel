    ],
    moc_headers = [
        "src/plugins/world_control/WorldControl.hh",
        "src/plugins/world_control/WorldControlEventListener.hh",
    ],
    qml = ["src/plugins/world_control/WorldControl.qml"],
    qrc = "src/plugins/world_control/WorldControl.qrc",
