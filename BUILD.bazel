gz_gui_plugin(
    name = "WorldStats",
    srcs = [
        "src/plugins/world_stats/WorldStats.cc",
    ],
    moc_headers = [
        "src/plugins/world_stats/WorldStats.hh",
    ],
    qml = ["src/plugins/world_stats/WorldStats.qml"],
    qrc = "src/plugins/world_stats/WorldStats.qrc",
)

gz_gui_plugin(
    name = "Screenshot",
    srcs = [
        "src/plugins/screenshot/Screenshot.cc",
    ],
    moc_headers = [
        "src/plugins/screenshot/Screenshot.hh",
    ],
    qml = [
        "src/plugins/screenshot/Screenshot.qml",
        "src/plugins/screenshot/screenshot.png",
        "src/plugins/screenshot/folder.png",
    ],
    qrc = "src/plugins/screenshot/Screenshot.qrc",
    deps = [
        "@gz-rendering",
    ],
)

gz_gui_plugin(
    name = "CameraTracking",
    srcs = [
        "src/plugins/camera_tracking/CameraTracking.cc",
    ],
    moc_headers = [
        "src/plugins/camera_tracking/CameraTracking.hh",
    ],
    qml = ["src/plugins/camera_tracking/CameraTracking.qml"],
    qrc = "src/plugins/camera_tracking/CameraTracking.qrc",
    deps = [
        "@gz-common//profiler",
